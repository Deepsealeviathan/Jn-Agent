{
  "default_model": "deepseek",
  "auto_approve": false,
  "max_tool_steps": 20,
  "shell_timeout": 120,
  "context_compress": {
    "enabled": true,
    "threshold_tokens": 190464,
    "keep_recent_messages": 6,
    "max_rounds": 4,
    "summarize_input_chars": 60000,
    "shrink_tool_output_chars": 1200
  },
  "system_prompt": "你是一个可以直接操作本机环境的通用智能体。可用工具：run_shell（执行 shell 命令）、read_file（读文件）、write_file（写文件）、list_dir（列目录）、publish_download（把文件复制到 WebUI 下载目录）、get_token_usage（查询本次会话和历史 Token 用量）。用户要求把某个文件加入下载路径、提供下载或分享文件时，调用 publish_download，不要只给出路径。需要事实时先用工具核实，不要凭空猜测文件内容或命令结果。用户询问 Token 消耗时，调用 get_token_usage 获取真实数据再回答。执行破坏性、不可逆或影响面较大的操作前，先说明原因。当用户只是在询问你是否具备某种能力（例如“能否生成小说”“可以写文章吗”“会不会写代码”）时，这属于确认性提问：先用一两句话回答可以或不可以，并询问主题、篇幅、风格、用途等必要信息，在用户明确确认前不要输出正文、示例、提纲或代码。对于可能产生较长内容的请求（小说、文章、报告、代码等），如果缺少主题、篇幅、风格等关键信息，先简短确认再生成，不要自行编造参数后直接输出。最终回答使用用户使用的语言，简洁、准确，给出关键结论。",
  "usage_log": "~/.multi-model-agent/usage.jsonl",
  "providers": {
    "kimi": {
      "protocol": "anthropic",
      "base_url": "https://api.kimi.com/coding/v1",
      "auth_style": "both",
      "api_key_env": "KIMI_API_KEY",
      "api_key_from": [
        {
          "file": "~/.kimi-code/credentials/kimi-code.json",
          "json_paths": [["access_token"], ["tokens", "access_token"]]
        },
        {
          "file": "~/.kimi-code/config.toml",
          "toml_path": ["providers", "managed:kimi-code", "api_key"]
        }
      ]
    },
    "deepseek": {
      "protocol": "openai",
      "base_url": "http://localhost:8030/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "enable_thinking_body": {"chat_template_kwargs": {"enable_thinking": true}},
      "disable_thinking_body": {"chat_template_kwargs": {"enable_thinking": false}},
      "api_key_from": {
        "file": "~/.kimi-code/config.toml",
        "toml_path": ["providers", "local-deepseek", "api_key"]
      }
    }
  },
  "models": {
    "deepseek": {
      "provider": "deepseek",
      "model": "DeepSeek-V4.1-Flash-1017",
      "display": "DeepSeek V4.1 Flash (local)",
      "max_context": 262144,
      "max_tokens": 262144,
      "max_tokens_from_context": true,
      "thinking_default": false,
      "thinking_max_tokens": 32768
    },
    "kimi": {
      "provider": "kimi",
      "model": "kimi-for-coding",
      "display": "Kimi K2.8 Preview",
      "max_context": 1048576,
      "max_tokens": 8192
    },
    "kimi-fast": {
      "provider": "kimi",
      "model": "kimi-for-coding-highspeed",
      "display": "Kimi K2.7 Code Highspeed",
      "max_context": 262144,
      "max_tokens": 8192
    },
    "k3": {
      "provider": "kimi",
      "model": "k3",
      "display": "Kimi K3",
      "max_context": 262144,
      "max_tokens": 8192
    },
    "k3-256k": {
      "provider": "kimi",
      "model": "k3-256k",
      "display": "Kimi K3 256k",
      "max_context": 262144,
      "max_tokens": 8192
    },
    "k3.1-pro": {
      "provider": "kimi",
      "model": "k3.1-pro-highspeed",
      "display": "Kimi K3.1 Pro Highspeed",
      "max_context": 1048576,
      "max_tokens": 8192
    }
  }
}
